#!/bin/bash -e

# These should match the list in deploy-testing.yml
cat << EOF > .env
DGC_BASE_URL=${DGC_BASE_URL}
DGC_API_KEY=${DGC_API_KEY}
MICROSOFT_LOGIN_CLIENT_ID=${MICROSOFT_LOGIN_CLIENT_ID}
MICROSOFT_LOGIN_OAUTH_SERVER=${MICROSOFT_LOGIN_OAUTH_SERVER}
EOF

# Generate firebase_options.dart from the Firebase project
npm install -g firebase-tools
dart pub global activate flutterfire_cli
export PATH="$PATH":"$HOME/.pub-cache/bin"
flutterfire configure \
  --project=rcpch-growth-charts-app \
  --platforms=android,web,ios \
  --yes

flutter pub get

flutter test

if [ $1 = "android" ]; then
  flutter build appbundle --release \
    --build-number ${BUILD_NUMBER}
elif [ $1 = "web" ]; then
  echo '.env file before web build:'
  cat .env
  flutter build web --release
  echo '.env file after web build:'
  ls -al build/web/assets/
  cat build/web/assets/.env
else
  echo "Unknown platform: $1"
  exit 1
fi
